#!/bin/sh
# Clone Studio snap shim for `apt-mark showmanual`.
#
# Inside the snap /var/lib/dpkg belongs to the core22 base, not the host, so
# the real apt-mark would describe the wrong system. This answers the one
# query the app makes - installed packages not marked as automatically
# installed - from the host's own database, which the `host-packages`
# (system-files) plug exposes read-only under /var/lib/snapd/hostfs.
HOSTFS=/var/lib/snapd/hostfs
STATUS=$HOSTFS/var/lib/dpkg/status
STATES=$HOSTFS/var/lib/apt/extended_states

if [ "$1" != showmanual ]; then
  echo "apt-mark: only 'showmanual' is available inside the Clone Studio snap" >&2
  exit 64
fi
if [ ! -r "$STATUS" ]; then
  echo "apt-mark: cannot read the host package database;" \
    "run: sudo snap connect clone-studio:host-packages" >&2
  exit 100
fi
[ -r "$STATES" ] || STATES=/dev/null

native=${SNAP_ARCH:-amd64}
awk -v native="$native" -v states="$STATES" '
  BEGIN { RS = ""; FS = "\n" }
  {
    pkg = ""; arch = native; status = ""; auto = 0
    for (i = 1; i <= NF; i++) {
      if ($i ~ /^Package: /) pkg = substr($i, 10)
      else if ($i ~ /^Architecture: /) arch = substr($i, 15)
      else if ($i ~ /^Status: /) status = substr($i, 9)
      else if ($i ~ /^Auto-Installed: /) auto = substr($i, 17) + 0
    }
    if (arch == "all") arch = native
    if (FILENAME == states) {
      if (auto) automatic[pkg ":" arch] = 1
    } else if (status ~ / installed$/ && !((pkg ":" arch) in automatic)) {
      print (arch == native ? pkg : pkg ":" arch)
    }
  }
' "$STATES" "$STATUS" | sort -u
